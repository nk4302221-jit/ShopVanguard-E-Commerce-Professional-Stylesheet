# Server Configuration
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (MySQL / Relational SQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_for_ecommerce_app_2026_xyz

# OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Stripe Sandbox Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_example123456
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
VITE_RAZORPAY_KEY_ID=rzp_test_example123456

# Google Maps API
GOOGLE_MAPS_API_KEY=

# Storj Cloud Storage
STORJ_ACCESS_KEY=
STORJ_SECRET_KEY=
STORJ_BUCKET=

# Optional Email SMTP (Nodemailer)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@shopvanguard.com

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
